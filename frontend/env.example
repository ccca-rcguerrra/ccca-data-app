# Configurações da API
VITE_API_BASE_URL=http://localhost:3000

# WebSocket (opcional — usa VITE_API_BASE_URL como fallback se não definido)
VITE_WS_URL=http://localhost:3000

# Outras configurações
VITE_APP_TITLE=SenseData Alertas

# Multi-iniciativa: a configuração específica da iniciativa (classes habilitadas,
# filtros territoriais, mapas/camadas) NÃO vem de env no frontend — é servida pelo
# backend em GET /api/system-config e consumida via useSystemConfig(). Basta o
# VITE_API_BASE_URL apontar para o backend da iniciativa correta.
