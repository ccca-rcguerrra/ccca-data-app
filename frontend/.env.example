# API URLs
VITE_MAIN_API_URL= 
VITE_AI_API_URL= 
VITE_AI_API_WS_URL=

# API keys
VITE_MAPTILER_KEY=

# Required for pnpm install to fetch private package @mapbiomas/ui from GitLab.
# Get token: GitLab -> Settings -> Access Tokens (read_api, read_registry).
# Before running pnpm install, either: export GITLAB_TOKEN=your_token
# or load this file: source .env (or use a script that sources .env and runs pnpm install).
GITLAB_TOKEN=