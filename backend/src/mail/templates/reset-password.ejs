<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light" />
  <meta name="supported-color-schemes" content="light" />
  <title>Reset your password</title>
</head>
<body style="margin:0;padding:0;background:#f3f8f5;font-family:'Segoe UI',Arial,sans-serif;color:#0f172a;">
  <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">
    Create a new password to access CCCA Data.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;min-width:100%;background:#f3f8f5;">
    <tr>
      <td align="center" style="padding:40px 16px;background:linear-gradient(135deg,#f5faf5 0%,#ffffff 48%,#eef6fb 100%);">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:448px;width:100%;">
          <tr>
            <td style="padding:0 0 18px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border:1px solid #eef2f7;border-radius:8px;box-shadow:0 18px 48px rgba(15,23,42,0.14);overflow:hidden;">
                <tr>
                  <td align="center" style="padding:32px 40px 0;">
                    <p style="margin:0;font-size:26px;line-height:1.2;font-weight:700;letter-spacing:0.2px;color:#0f172a;">
                      CCCA <span style="color:#9d1f16;">Data</span>
                    </p>
                  </td>
                </tr>

                <tr>
                  <td style="padding:20px 40px 0;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="border-top:1px solid #e5e7eb;font-size:0;line-height:0;">&nbsp;</td>
                        <td width="38" align="center" style="font-size:0;line-height:0;">
                          <span style="display:inline-block;width:8px;height:8px;border-radius:999px;background:#2ca25f;"></span>
                        </td>
                        <td style="border-top:1px solid #e5e7eb;font-size:0;line-height:0;">&nbsp;</td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <tr>
                  <td style="padding:28px 40px 34px;">
                    <h1 style="margin:0;text-align:center;font-size:22px;line-height:1.25;font-weight:700;color:#0f172a;">
                      Reset your password
                    </h1>
                    <p style="margin:10px 0 24px;text-align:center;font-size:14px;line-height:1.5;color:#64748b;">
                      Click the link below to create a new password.
                    </p>

                    <p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#334155;">
                      Hello, <strong style="color:#0f172a;"><%= firstName %></strong>.
                    </p>
                    <p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#334155;">
                      We received a password reset request for your CCCA Data account.
                    </p>

                    <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                      <tr>
                        <td align="center">
                          <a href="<%= resetUrl %>" style="display:block;background:#087236;color:#ffffff;font-size:14px;line-height:1;font-weight:700;text-decoration:none;padding:14px 28px;border-radius:8px;box-shadow:0 10px 18px rgba(8,114,54,0.18);">
                            Reset password
                          </a>
                        </td>
                      </tr>
                    </table>

                    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin-top:24px;background:#f8faf8;border:1px solid #e6efe9;border-left:4px solid #2ca25f;border-radius:8px;">
                      <tr>
                        <td style="padding:14px 16px;">
                          <p style="margin:0 0 6px;font-size:13px;line-height:1.5;color:#334155;">
                            <strong>This link expires in 1 hour.</strong>
                          </p>
                          <p style="margin:0;font-size:13px;line-height:1.5;color:#64748b;">
                            If you did not request a password reset, ignore this email. Your password remains unchanged.
                          </p>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:22px 0 0;font-size:12px;line-height:1.6;color:#94a3b8;">
                      If the button does not work, copy and paste the link below in your browser:<br />
                      <a href="<%= resetUrl %>" style="color:#0066cc;text-decoration:none;word-break:break-all;"><%= resetUrl %></a>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:0 12px;">
              <p style="margin:0;font-size:12px;line-height:1.5;color:#64748b;">
                © CCCA Data · All rights reserved
              </p>
              <p style="margin:6px 0 0;font-size:11px;line-height:1.5;color:#94a3b8;">
                This is an automated email, please do not reply.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
