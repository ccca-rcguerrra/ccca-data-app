  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "cli": "ts-node -r tsconfig-paths/register src/cli.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/model/typeorm.datasource.ts --pretty",
    "migration:create": "npm run typeorm -- migration:create -d src/model/typeorm.datasource.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/model/typeorm.datasource.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/model/typeorm.datasource.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/model/typeorm.datasource.ts"
  },
